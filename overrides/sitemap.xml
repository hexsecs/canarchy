{#-
  Overrides the MkDocs sitemap to list only user-facing pages.

  The design/, tests/, and benchmarks/ pages stay published and stay in the
  site's own search; they are simply left out of the sitemap so search
  engines weigh the site by its guides, tutorials, and cookbook rather than
  by ~100 internal specification and record pages. The matching robots meta
  tag is set in main.html — keep the two lists in step.
-#}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for file in pages -%}
    {% if not file.page.is_link and (file.page.abs_url or file.page.canonical_url)
          and not file.src_uri.startswith(("design/", "tests/", "benchmarks/")) %}
    <url>
         <loc>{% if file.page.canonical_url %}{{ file.page.canonical_url|e }}{% else %}{{ file.page.abs_url|e }}{% endif %}</loc>
         {% if file.page.update_date %}<lastmod>{{ file.page.update_date }}</lastmod>{% endif %}
    </url>
    {%- endif -%}
{% endfor %}
</urlset>
